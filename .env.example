# --- LLM (anthropic | openai | none) ---
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- 임베딩 (huggingface | openai | hash) ---
# huggingface 는 requirements-hf.txt 설치 필요. 패키지가 없으면 hash 로 자동 폴백(경고 로그)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# --- 외부 Tool (키 없으면 자동 mock) ---
OPENWEATHER_API_KEY=
WEATHER_MODE=auto
EXCHANGE_MODE=auto
EXCHANGE_API_BASE=https://open.er-api.com/v6/latest

# --- RAG ---
GUIDES_DIR=
RAG_INDEX_DIR=
RAG_TOP_K=4
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80

# --- 동작 ---
HTTP_TIMEOUT=5
MAX_STEPS=8

# --- 웹 (sqlite | memory) ---
WEB_CHECKPOINT=sqlite
WEB_DB_PATH=
